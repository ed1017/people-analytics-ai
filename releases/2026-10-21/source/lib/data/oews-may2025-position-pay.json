  "fieldDefinitions": {
    "A_MEAN": {
      "definition": "Mean annual wage ",
      "source_cells": [
        "A29",
        "B29"
      ]
    },
    "A_MEDIAN": {
      "definition": "Annual median wage (or the 50th percentile)",
      "source_cells": [
        "A38",
        "B38"
      ]
    },
    "ANNUAL": {
      "definition": "Contains \"TRUE\" if only annual wages are released. The OEWS program releases only annual wages for some occupations that typically work fewer than 2,080 hours per year, but are paid on an annual basis, such as teachers, pilots, and athletes.",
      "source_cells": [
        "A41",
        "B41"
      ]
    },
    "HOURLY": {
      "definition": "Contains \"TRUE\" if only hourly wages are released. The OEWS program releases only hourly wages for some occupations that typically work fewer than 2,080 hours per year and are paid on an hourly basis, such as actors, dancers, and musicians and singers.",
      "source_cells": [
        "A42",
        "B42"
      ]
    },
    "TOT_EMP": {
      "definition": "Estimated total employment rounded to the nearest 10 (excludes self-employed).",
      "source_cells": [
        "A22",
        "B22"
      ]
    },
    "EMP_PRSE": {
      "definition": "Percent relative standard error for the employment estimate, not wage estimate.",
      "source_cells": [
        "A23",
        "B23"
      ]
    },
    "MEAN_PRSE": {
      "definition": "Percent relative standard error for the mean wage estimate, not median uncertainty.",
      "source_cells": [
        "A30",
        "B30"
      ]
    }
  },
  "sourceNotes": [
    {
      "text": "*  = indicates that a wage estimate is not available",
      "source_cell": "A45"
    },
    {
      "text": "**  = indicates that an employment estimate is not available",
      "source_cell": "A46"
    },
    {
      "text": "#  = indicates a wage equal to or greater than $115.00 per hour or $239,200 per year ",
      "source_cell": "A47"
    },
    {
      "text": "~ =indicates that the percent of establishments reporting the occupation is less than 0.5%",
      "source_cell": "A48"
    }
  ],
