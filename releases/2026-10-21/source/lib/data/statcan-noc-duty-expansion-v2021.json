      {
        "csvRecord": 21364,
        "elementType": "Main duties",
        "text": "This group performs some or all of the following duties: "
      },
      {
        "csvRecord": 21365,
        "elementType": "Main duties",
        "text": "Promote sales to existing clients "
      },
      {
        "csvRecord": 21366,
        "elementType": "Main duties",
        "text": "Identify and solicit potential clients "
      },
      {
        "csvRecord": 21367,
        "elementType": "Main duties",
        "text": "Provide clients with presentations on the benefits and uses of goods or services "
      },
      {
        "csvRecord": 21368,
        "elementType": "Main duties",
        "text": "Estimate or quote prices, credit or contract terms, warranties and delivery dates "
      },
      {
        "csvRecord": 21369,
        "elementType": "Main duties",
        "text": "Prepare or oversee preparation of sales or other contracts "
      },
      {
        "csvRecord": 21370,
        "elementType": "Main duties",
        "text": "Consult with clients after sale or signed contracts to resolve problems and to provide ongoing support "
      },
      {
        "csvRecord": 21371,
        "elementType": "Main duties",
        "text": "Review and adapt to information regarding product innovations, competitors and market conditions "
      },
      {
        "csvRecord": 21372,
        "elementType": "Main duties",
        "text": "Represent companies that export and import products or services to and from foreign countries "
      },
      {
        "csvRecord": 21373,
        "elementType": "Main duties",
        "text": "May conduct sales transactions through Internet-based electronic commerce "
      },
      {
        "csvRecord": 21374,
        "elementType": "Main duties",
        "text": "May supervise the activities of other sales representatives. "
      },
      {
        "csvRecord": 21375,
        "elementType": "Employment requirements",
        "text": "Completion of secondary school is required. "
      },
      {
        "csvRecord": 21376,
        "elementType": "Employment requirements",
        "text": "A university degree or completion of a college or other program may be required. "
      },
      {
        "csvRecord": 21377,
        "elementType": "Employment requirements",
        "text": "Experience in sales or in an occupation related to the product or service is usually required. "
      },
      {
